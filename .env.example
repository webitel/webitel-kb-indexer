CONSUL_ADDR=127.0.0.1:8500
PUBSUB_URL=amqp://user:pass@127.0.0.1:5672?heartbeat=10
POSTGRES_DSN=postgres://user:pass@127.0.0.1:5432/webitel?application_name=webitel-kb-indexer&sslmode=disable&connect_timeout=10

# The name kb-api is registered in consul under.
#KB_API_SERVICE=webitel-kb

# The token is the one kb-api is configured with (>32 chars).
KB_API_SERVICE_TOKEN=
#KB_API_TLS=false
#KB_API_TIMEOUT=5.0

# Seconds a resolved model is reused, and seconds one provider call may take.
#EMBEDDING_CACHE_TTL=300.0
#EMBEDDING_TIMEOUT=30.0

# Attempts at one message before it is dead lettered, and the first delay
# between them in seconds (doubling, capped at 30).
#CONSUMER_RETRIES=5
#CONSUMER_RETRY_BACKOFF=1.0
# Seconds a shutdown waits for the delivery in flight; keep it below
# TimeoutStopSec of the systemd unit or the stop ends in SIGKILL.
#CONSUMER_SHUTDOWN_TIMEOUT=30.0

# Log level: debug, info, warn, error (default: info)
#LOG_LEVEL=info
#LOG_JSON=true
#LOG_CONSOLE=true
#LOG_FILE=
#LOG_OTEL=false
